# Copy this file to .env (in hw5/ or the folder above it) and fill in your key.
# The real .env is git-ignored and must never be committed.

# Required: Portkey AI gateway key. Every agent uses gpt-6-luna through Portkey.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional per-ticket token guardrails (defaults shown)
# TICKET_REQUEST_LIMIT=30
# TICKET_TOKEN_LIMIT=150000
